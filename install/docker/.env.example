# =============================================================================
# agent-phi docker-compose configuration
# -----------------------------------------------------------------------------
# Copy this file to .env and adjust values before running:
#   cp .env.example .env
#
# NOTE: Docker Compose does not expand ~ in paths. Use an absolute path:
#   AGENT_BASE=/home/youruser/agent-phi   (always works)
# =============================================================================


# =============================================================================
# SHARED — set once, applies to all services
# =============================================================================

# Base installation folder for the entire agent stack on this host.
# All service state lives under ${AGENT_BASE}/state/<service>.
# Must be an absolute path.
AGENT_BASE=/home/user/agent-phi

# Name of the shared Docker network all services join.
# Convention: use the last path segment of AGENT_BASE.
# Example: AGENT_BASE=/home/user/agent-phi  →  AGENT_NETWORK=agent-phi
# Create it once before first boot:  docker network create ${AGENT_NETWORK}
AGENT_NETWORK=agent-phi


# =============================================================================
# PAPERCLIP — orchestration control plane
# =============================================================================

# Host port Paperclip listens on. Maps to internal port 3100.
PAPERCLIP_PORT=3100

# Instance ID — used to namespace config/db/secrets within ${AGENT_BASE}/state/paperclip.
# Change this if you run multiple instances on the same host.
PAPERCLIP_INSTANCE_ID=default

# Deployment mode.
#   local_trusted  — single-user, no login required (good for dev/solo use)
#   authenticated  — multi-user, session-based login (recommended for shared/public)
PAPERCLIP_DEPLOYMENT_MODE=authenticated

# Exposure mode (only applies when DEPLOYMENT_MODE=authenticated).
#   private  — enforce hostname allowlist; blocks unknown Host headers
#   public   — allow any hostname (behind a reverse proxy)
PAPERCLIP_DEPLOYMENT_EXPOSURE=private

# Public base URL used for OAuth callbacks and auth emails.
# Must be set when DEPLOYMENT_MODE=authenticated.
# Example: http://localhost:3100  or  https://paperclip.yourdomain.com
PAPERCLIP_PUBLIC_URL=http://localhost:${PAPERCLIP_PORT}

# Set to true to disable new user registration (invite-only).
PAPERCLIP_AUTH_DISABLE_SIGN_UP=false

# Secrets encryption strictness. When true, Paperclip refuses to start if
# the master key file cannot be read.
PAPERCLIP_SECRETS_STRICT_MODE=false

# Docker image tag to use when pulling a pre-built image instead of building.
# Ignored when building locally with `docker compose up --build`.
PAPERCLIP_IMAGE_TAG=latest


# =============================================================================
# OPENFANG — autonomous agent OS  (uncomment service in docker-compose.yml)
# =============================================================================

# Host port OpenFang's HTTP API listens on. Maps to internal port 4200.
OPENFANG_PORT=4200

# Docker image tag for OpenFang.
OPENFANG_IMAGE_TAG=latest


# =============================================================================
# QMD / MEMORY — shared memory layer  (uncomment service in docker-compose.yml)
# =============================================================================

# Host port for qmd. Maps to container port 8181.
QMD_PORT=8181

# Docker image tag for qmd.
QMD_IMAGE_TAG=latest
